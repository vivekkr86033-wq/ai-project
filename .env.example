# ============================================================
# AI-Based Smart Home Energy Management — Environment Variables
# ============================================================
# Copy this file to .env and configure your values.
# ALL keys are OPTIONAL. The planner operates fully offline
# using deterministic grounded fallback synthesis.
# ============================================================

# --- LLM Provider (optional for Generative Assistant) --------
# Options: "openai", "none"
LLM_PROVIDER=none

# OpenAI configuration (only required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo

# --- Smart Home Physical Device Defaults ---------------------
DEFAULT_BREAKER_CAPACITY_KW=10.0
DEFAULT_BATTERY_CAPACITY_KWH=10.0
DEFAULT_BATTERY_RESERVE_SOC=0.20

# --- Suppress Windows Symlink Warnings -----------------------
HF_HUB_DISABLE_SYMLINKS_WARNING=1
